# Caddy reverse proxy for Moodle. Deploy to /etc/caddy/Caddyfile on the VM.
#
# - TLS certificates via automatic Let's Encrypt (HTTP-01); port 80 must stay open.
# - HTTP -> HTTPS redirect is automatic in Caddy.

oivus.pnr.iki.fi {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
	header {
		# 180 d; no includeSubDomains/preload, to keep the later move to an
		# own domain unconstrained.
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
