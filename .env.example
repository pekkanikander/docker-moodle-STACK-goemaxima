# Copy to .env and adjust values for your environment.

# Host-local port for Moodle; matches the MOODLE_DOCKER_WEB_PORT=8000 used in
# the moodlehq/moodle-docker README examples.
MOODLE_HTTP_PORT=8000
MOODLE_SITE_URL=https://moodle.example.com
MOODLE_SITE_FULLNAME="Moodle Site"
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_ADMIN_PASSWORD=change-me
# Set to 1 to force an admin password change at first login (used by the
# generated local-setup .env, where the install password is a known constant).
MOODLE_ADMIN_FORCE_PASSWORD_CHANGE=0
MOODLE_NOREPLY_EMAIL=noreply@example.com

# Outgoing mail target as host:port; mail-init.sh applies changes to an
# installed site. The default points at the bundled Mailpit capture (local
# development and CI; needs the mail-capture profile below). For a server,
# set a real authenticated relay (e.g. smtp.iki.fi:587 with
# MOODLE_SMTPSECURE=tls) and configure its credentials in the Moodle admin
# UI (Server > Email > Outgoing mail configuration), never here.
MOODLE_SMTPHOSTS=mailpit:1025
# SMTP transport security: empty (none), "tls" (STARTTLS, port 587) or
# "ssl" (implicit TLS, port 465). Empty for Mailpit.
MOODLE_SMTPSECURE=
# Compose profiles: "mail-capture" runs the bundled Mailpit. Set empty on
# servers that relay to a real SMTP host.
COMPOSE_PROFILES=mail-capture
# Host-local port for the Mailpit web UI.
MAILPIT_HTTP_PORT=8025

# Moodle language packs to install (comma- or space-separated codes, e.g. "fi").
# Moodle picks the browser's Accept-Language when its pack is installed;
# MOODLE_LANG is only the fallback for browsers that ask for anything else.
MOODLE_LANGPACKS=
MOODLE_LANG=en

MOODLE_PERSISTENT_ROOT=/srv/moodle-persistent

MARIADB_UID=2001
MARIADB_GID=2001

MOODLE_STACK_MAXIMAVERSION=5.44.0
MOODLE_STACK_MAXIMACOMMAND=
MOODLE_STACK_MAXIMACOMMANDOPT=
MOODLE_STACK_MAXIMACOMMANDSERVER=http://maxima:8080/goemaxima
MOODLE_STACK_MAXIMALIBRARIES="stats, distrib, descriptive"
MOODLE_STACK_PLATFORM="server"
